# --- Project name –-- #
COMPOSE_PROJECT_NAME=llm_serving


# --- Model Configuration (update all three when switching models) --- #

# Full HuggingFace model path (used by vLLM to download and load the model weights)
HF_MODEL_ID=nvidia/Qwen3.6-35B-A3B-NVFP4

# Short model name used in API requests and as the vLLM served-model name
MODEL_NAME=Qwen3.6-35B-A3B-NVFP4

# LiteLLM routing key – must always be "openai/" + MODEL_NAME for vLLM backends
LITELLM_MODEL=openai/Qwen3.6-35B-A3B-NVFP4


# --- Authentication Tokens and API Keys --- #
# Generate Keys with: python3 -c "import secrets; print('vllm-' + secrets.token_urlsafe(32))"

# HuggingFace token (required – accept the model licence at https://huggingface.co/nvidia/Qwen3.6-35B-A3B-NVFP4)
HF_TOKEN=

# LiteLLM master API key (clients use this to authenticate)
LITELLM_MASTER_KEY=

# vLLM internal API key (defense-in-depth: authenticates LiteLLM → vLLM traffic)
VLLM_API_KEY=


# --- vLLM Inference Parameters --- #

# Weight and activation data type (auto, float16, bfloat16, float32)
VLLM_DTYPE=auto

# Quantization: set to "--quantization <method>" to enable, leave empty to disable.
# Supported methods: modelopt, awq, gptq, fp8, bitsandbytes, marlin, squeezellm, ...
# The variable encodes both the flag and the type so that leaving it empty
# cleanly disables quantization (Docker Compose cannot nest variable expansions).
# NVIDIA NVFP4 checkpoints require "modelopt" (the quantization engine), not "nvfp4".
VLLM_QUANTIZATION_ARG="--quantization=modelopt"

# Prefix caching: set to "--enable-prefix-caching" to enable, leave empty to disable
VLLM_ENABLE_PREFIX_CACHING=--enable-prefix-caching

# Chunked prefill: set to "--enable-chunked-prefill" to enable, leave empty to disable.
# Splits long prefill phases into chunks, improving latency for concurrent requests.
VLLM_ENABLE_CHUNKED_PREFILL=--enable-chunked-prefill

# Language model only: set to "--language-model-only" to load only the LM head (skip vision encoder).
# Only enable for text-only deployments of multimodal models to save memory.
# Qwen3.6-35B-A3B-NVFP4 is multimodal (text+image+video); leave empty to keep full capability.
VLLM_LANGUAGE_MODEL_ONLY=

# Tool calling: set to "--enable-auto-tool-choice" to let the model invoke tools autonomously, leave empty to disable
VLLM_ENABLE_AUTO_TOOL_CHOICE=--enable-auto-tool-choice

# Tool call parser: full flag passed to vLLM, e.g. "--tool-call-parser gemma4"
# Common values: gemma4, hermes, mistral, llama3_json, llama4_pythonic, qwen3_xml, qwen3_coder
# Qwen3.6-35B-A3B-NVFP4 model card recommends qwen3_xml for DGX Spark.
VLLM_TOOL_CALL_PARSER_ARG="--tool-call-parser=qwen3_xml"

# Reasoning parser: full flag passed to vLLM, e.g. "--reasoning-parser qwen3"
# Enables structured extraction of <think>...</think> blocks from the model output.
# Common values: qwen3, deepseek_r1
VLLM_REASONING_PARSER_ARG="--reasoning-parser=qwen3"

# Maximum sequence length (prompt + generation tokens); lower values reduce VRAM usage.
# Qwen3.6-35B-A3B-NVFP4 supports up to 262144 tokens (262K context).
VLLM_MAX_MODEL_LEN=262144

# Maximum total tokens across all concurrent requests in one scheduler step
VLLM_MAX_NUM_BATCHED_TOKENS=8192

# Maximum number of sequences processed concurrently; affects throughput vs. latency.
# DGX Spark recommendation: 4 (unified memory limits concurrency).
VLLM_MAX_NUM_SEQS=4

# Fraction of GPU memory reserved for the KV cache (0.0–1.0).
# DGX Spark has 128 GB unified CPU+GPU memory; 0.40 avoids starving the OS/CPU.
VLLM_GPU_MEMORY_UTILIZATION=0.60

# Tensor parallelism: set to "--tensor-parallel-size <n>" for multi-GPU, leave empty for single-GPU.
# DGX Spark has a single GPU — leave empty.
# Also increase VLLM_SHM_SIZE proportionally (e.g. 32g for 2 GPUs, 64g for 4 GPUs).
VLLM_TENSOR_PARALLEL_ARG=

# Shared memory size for NCCL inter-GPU communication; scale with tensor parallelism degree
VLLM_SHM_SIZE=16g


# --- DGX Spark Optimizations (NVIDIA GB10 Grace Blackwell) --- #

# KV cache data type: set to "--kv-cache-dtype fp8" to halve KV cache memory on Blackwell, leave empty to disable
VLLM_KV_CACHE_DTYPE_ARG="--kv-cache-dtype=fp8"

# Attention backend: set to "--attention-backend flashinfer" for optimized attention on Blackwell, leave empty for default
VLLM_ATTENTION_BACKEND_ARG="--attention-backend=flashinfer"

# MoE backend: set to "--moe-backend marlin" for optimized MoE dispatch on Blackwell, leave empty for default
VLLM_MOE_BACKEND_ARG="--moe-backend=marlin"

# Async scheduling: set to "--async-scheduling" to overlap scheduling with execution, leave empty to disable
VLLM_ASYNC_SCHEDULING=--async-scheduling

# Load format: set to "--load-format fastsafetensors" for faster model loading, leave empty for default
VLLM_LOAD_FORMAT_ARG="--load-format=fastsafetensors"

# Trust remote code: set to "--trust-remote-code" to allow model-supplied custom code, leave empty to disable
VLLM_TRUST_REMOTE_CODE=--trust-remote-code

# Speculative decoding (MTP): set full flag to enable Multi-Token Prediction, leave empty to disable.
# Improves throughput by predicting multiple tokens per step.
VLLM_SPECULATIVE_CONFIG_ARG=--speculative-config={\"method\":\"mtp\",\"num_speculative_tokens\":3,\"moe_backend\":\"triton\"}


# --- LiteLLM Gateway Parameters --- #

# Number of Uvicorn worker processes (increase for higher request concurrency)
LITELLM_NUM_WORKERS=2
