# --- Project name –-- #
COMPOSE_PROJECT_NAME=llm_serving


# --- Model Configuration (update all three when switching models) --- #

# Full HuggingFace model path (used by vLLM to download and load the model weights)
HF_MODEL_ID=Qwen/Qwen3.8-27B-FP8

# Short model name used in API requests and as the vLLM served-model name
MODEL_NAME=Qwen3.8-27B-FP8

# LiteLLM routing key – must always be "openai/" + MODEL_NAME for vLLM backends
LITELLM_MODEL=openai/Qwen3.8-27B-FP8


# --- Authentication Tokens and API Keys --- #
# Generate Keys with: python3 -c "import secrets; print('vllm-' + secrets.token_urlsafe(32))"

# HuggingFace token (required – accept the model licence at https://huggingface.co/Qwen/Qwen3.8-27B-FP8)
HF_TOKEN=

# LiteLLM master API key (clients use this to authenticate)
LITELLM_MASTER_KEY=

# vLLM internal API key (defense-in-depth: authenticates LiteLLM → vLLM traffic)
VLLM_API_KEY=


# --- vLLM Inference Parameters --- #
# Each variable contains the full CLI flag (--flag=value or --flag).
# Leave empty to disable an optional feature.

# Weight and activation data type (auto, float16, bfloat16, float32)
VLLM_DTYPE_ARG=--dtype=auto

# Quantization method (modelopt, awq, gptq, fp8, bitsandbytes, marlin, squeezellm, ...)
# Qwen3.8-27B-FP8 declares quant_method=fp8 in its own config.json; vLLM auto-detects it, leave empty.
VLLM_QUANTIZATION_ARG=

# Prefix caching: reuses KV cache across requests with shared prefixes
VLLM_ENABLE_PREFIX_CACHING=--enable-prefix-caching

# Chunked prefill: splits long prefill phases into chunks, improving latency for concurrent requests
VLLM_ENABLE_CHUNKED_PREFILL=--enable-chunked-prefill

# Language model only: load only the LM head (skip vision encoder) to save memory.
# Qwen3.8-27B-FP8 is multimodal (text+image+video); leave empty to keep full capability.
# NOTE: currently a no-op placeholder — no verified vLLM CLI flag is wired to this variable yet.
# The vision encoder loads regardless of whether this is set (confirmed by the "vit attention" /
# "MMEncoderAttention" backend-selection log lines during EngineCore init).
VLLM_LANGUAGE_MODEL_ONLY=

# Multimodal capacity: max number of images/videos accepted per prompt. Without this, vLLM
# falls back to its own default limit, which may silently reject requests with more images
# than expected. Set explicitly to the capacity your clients actually need.
# Syntax: dot-notation, one flag per modality (per vLLM docs: --limit-mm-per-prompt.<modality> <n>).
VLLM_LIMIT_MM_PER_PROMPT_ARG=--limit-mm-per-prompt.image=4 --limit-mm-per-prompt.video=1

# Tool calling: let the model invoke tools autonomously
VLLM_ENABLE_AUTO_TOOL_CHOICE=--enable-auto-tool-choice

# Tool call parser (gemma4, hermes, mistral, llama3_json, llama4_pythonic, qwen3_xml, qwen3_coder)
# Qwen3.8-27B-FP8 (Qwen3.5-generation architecture) uses the qwen3_coder parser.
VLLM_TOOL_CALL_PARSER_ARG=--tool-call-parser=qwen3_coder

# Reasoning parser: extracts <think>...</think> blocks from model output (qwen3, deepseek_r1)
VLLM_REASONING_PARSER_ARG=--reasoning-parser=qwen3

# Maximum sequence length (prompt + generation tokens); lower values reduce VRAM usage.
# Qwen3.8-27B-FP8 supports up to 262144 tokens (262K context).
VLLM_MAX_MODEL_LEN_ARG=--max-model-len=262144

# Maximum total tokens across all concurrent requests in one scheduler step
VLLM_MAX_NUM_BATCHED_TOKENS_ARG=--max-num-batched-tokens=8192

# Maximum number of sequences processed concurrently; affects throughput vs. latency.
# DGX Spark recommendation: 4 (unified memory limits concurrency).
VLLM_MAX_NUM_SEQS_ARG=--max-num-seqs=4

# Fraction of GPU memory reserved for the KV cache (0.0-1.0).
# DGX Spark has 128 GB unified CPU+GPU memory; 0.40 avoids starving the OS/CPU.
VLLM_GPU_MEMORY_UTILIZATION_ARG=--gpu-memory-utilization=0.60

# Tensor parallelism for multi-GPU (e.g. --tensor-parallel-size=2); leave empty for single-GPU.
# DGX Spark has a single GPU. Increase VLLM_SHM_SIZE proportionally (32g for 2 GPUs, 64g for 4).
VLLM_TENSOR_PARALLEL_ARG=

# Shared memory size for NCCL inter-GPU communication; scale with tensor parallelism degree
VLLM_SHM_SIZE=16g


# --- DGX Spark Optimizations (NVIDIA GB10 Grace Blackwell) --- #

# KV cache data type: fp8 halves KV cache memory on Blackwell
VLLM_KV_CACHE_DTYPE_ARG=--kv-cache-dtype=fp8

# Attention backend: flashinfer is optimized for Blackwell
VLLM_ATTENTION_BACKEND_ARG=--attention-backend=flashinfer

# MoE backend: marlin is optimized for MoE dispatch on Blackwell.
# Qwen3.8-27B-FP8 is a dense model (no MoE layers); leave empty.
VLLM_MOE_BACKEND_ARG=

# Async scheduling: overlaps scheduling with execution
VLLM_ASYNC_SCHEDULING=--async-scheduling

# Load format: fastsafetensors for faster model loading
VLLM_LOAD_FORMAT_ARG=--load-format=fastsafetensors

# Trust remote code: allow model-supplied custom code
VLLM_TRUST_REMOTE_CODE=--trust-remote-code

# Speculative decoding (MTP): set full flag to enable Multi-Token Prediction, leave empty to disable.
# Improves throughput by predicting multiple tokens per step.
VLLM_SPECULATIVE_CONFIG_ARG=--speculative-config={\"method\":\"mtp\",\"num_speculative_tokens\":3}

# CUDA graph capture sizes: by default vLLM captures graphs for batch sizes up to 32
# (1,2,4,8,16,24,32), but VLLM_MAX_NUM_SEQS_ARG caps concurrent sequences at 4, so sizes
# 8/16/24/32 are never reachable — they only waste startup compile time and VRAM.
# Capping the list to sizes <= max-num-seqs recovers that VRAM for the KV cache.
VLLM_COMPILATION_CONFIG_ARG=--compilation-config={\"cudagraph_capture_sizes\":[1,2,4]}


# --- LiteLLM Gateway Parameters --- #

# Number of Uvicorn worker processes.
# Keep at 1: litellm_config.yaml uses an in-process ("local") cache, which is
# NOT shared across workers — with >1 worker, identical requests only hit the
# cache when routed back to the same process, silently degrading the hit rate.
# The single vLLM backend (max_parallel_requests=4) is the real concurrency
# limit anyway, so a second worker buys little. Only raise this if cache_params
# in litellm_config.yaml is switched to a shared backend (e.g. Redis).
LITELLM_NUM_WORKERS=1
